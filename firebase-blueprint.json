{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile details and macro targets",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "description": "Email associated with user" },
        "age": { "type": "number", "description": "Age of the user" },
        "gender": { "type": "string", "description": "Gender of the user", "enum": ["Erkek", "Kadın"] },
        "height": { "type": "number", "description": "Height in cm" },
        "weight": { "type": "number", "description": "Current weight in kg" },
        "targetWeight": { "type": "number", "description": "Target weight in kg" },
        "activityLevel": { "type": "string", "description": "Activity level of the user" },
        "currentTargets": { "$ref": "#/entities/DailyTargets" }
      },
      "required": ["name", "email"]
    },
    "DailyTargets": {
      "title": "DailyTargets",
      "description": "Daily nutrient targets of the user",
      "type": "object",
      "properties": {
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "water": { "type": "number" },
        "fiber": { "type": "number" },
        "sodium": { "type": "number" },
        "sugarLimit": { "type": "number" }
      },
      "required": ["calories"]
    },
    "DayLog": {
      "title": "DayLog",
      "description": "Nutrition logger records for a single day",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "meals": { "$ref": "#/entities/DayMeals" },
        "waterConsumedMl": { "type": "number" },
        "dailyTargets": { "$ref": "#/entities/DailyTargets" },
        "summaryNote": { "type": "string" }
      },
      "required": ["date"]
    },
    "DayMeals": {
      "title": "DayMeals",
      "description": "Meals categorised in a day",
      "type": "object",
      "properties": {
        "breakfast": { "type": "array" },
        "lunch": { "type": "array" },
        "dinner": { "type": "array" },
        "snack": { "type": "array" }
      }
    },
    "WeightLog": {
      "title": "WeightLog",
      "description": "Individual weight logs",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "weight": { "type": "number" }
      },
      "required": ["date", "weight"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profile detail logs of each user"
    },
    "/users/{userId}/logs/{date}": {
      "schema": "DayLog",
      "description": "Nutrition logs of a user by day"
    },
    "/users/{userId}/weightLogs/{date}": {
      "schema": "WeightLog",
      "description": "Weight entries of a user by date"
    }
  }
}
